# Environment Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3001
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_watchlist
DB_USER=postgres
# On macOS with Homebrew PostgreSQL, DB_USER is usually your macOS username
# and DB_PASSWORD can be left empty (peer/trust auth)
DB_PASSWORD=your_postgres_password

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Market Data (Alpha Vantage - free tier)
# Get your free key at: https://www.alphavantage.co/support/#api-key
MARKET_DATA_PROVIDER=alphavantage
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here

# Demo user (used until auth is implemented)
DEMO_USER_ID=1

# Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
